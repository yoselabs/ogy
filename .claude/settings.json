{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "(bd list --status in_progress --json 2>/dev/null || echo '[]') | jq -c 'if length > 0 then {systemMessage: (\"beads left in_progress: \" + ([.[] | .id] | join(\", \")))} else empty end'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/docs/kb/**/*.yml)",
      "Write(/docs/kb/**/*.yml)"
    ]
  },
  "env": {
    "BD_DISABLE_METRICS": "1"
  }
}
